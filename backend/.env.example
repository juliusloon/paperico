# Paperico backend configuration
# Copy to backend/.env and uncomment what you need. Everything is optional —
# the app also works with no .env file at all.
#
# Keys can be provided here OR entered in the Settings page of any client
# (web client → 设置/Settings). Settings-page keys are stored encrypted
# (Fernet) in the local database; .env values take precedence as defaults.

# ── LLM (OpenAI-compatible; powers translation, outline, method cards, chat) ──
#PAPERICO_LLM_BASE_URL=https://api.openai.com/v1
#PAPERICO_LLM_API_KEY=
#PAPERICO_LLM_MODEL=gpt-4o-mini

# ── MinerU PDF parsing (cloud https://mineru.net/api/v4 or self-hosted) ──
#PAPERICO_MINERU_BASE_URL=https://mineru.net/api/v4
#PAPERICO_MINERU_API_KEY=
#PAPERICO_MINERU_MODEL_BACKEND=pipeline   # pipeline | vlm

# ── Credential encryption ──
# 32-byte url-safe base64 Fernet key; leave unset to auto-generate and persist
# a machine-local key under the storage root (mode 0600).
#PAPERICO_ENCRYPTION_KEY=

# ── Storage / database ──
#PAPERICO_STORAGE_ROOT=
#PAPERICO_DATABASE_URL=sqlite+aiosqlite:///paperico.db

# ── Job governance ──
#PAPERICO_USE_JOB_CENTER=true
#PAPERICO_JOB_KIND_LIMITS={"mineru": 4}
#PAPERICO_TRASH_RETENTION_DAYS=7

# ── Chat context ──
# Legacy hard truncation fallback (only if context assembly quality regresses)
#PAPERICO_CHAT_LEGACY_TRUNCATION=false
